 *
 * PHYTEC distancer (rev 3) - DWM1001-based UWB distancing device.
 * nRF52832-CIAA + DW1000 UWB transceiver + MX25R8035F SPI-NOR flash.
 */

/dts-v1/;
#include <nordic/nrf52832_ciaa.dtsi>
#include "distancer-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "PHYTEC distancer";
	compatible = "phytec,distancer", "decawave,dwm1001",
		     "nordic,nrf52832-ciaa", "nordic,nrf52832";

	chosen {
		zephyr,console        = &uart0;
		zephyr,shell-uart     = &uart0;
		zephyr,uart-mcumgr    = &uart0;
		zephyr,bt-mon-uart    = &uart0;
		zephyr,bt-c2h-uart    = &uart0;
		zephyr,sram           = &sram0;
		zephyr,flash          = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,ieee802154     = &ieee802154;
	};

	leds {
		compatible = "gpio-leds";

		rgb_1_r: rgb_1_r {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "D23-D26 red";
		};
		rgb_1_g: rgb_1_g {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
			label = "D23-D26 green";
		};
		rgb_1_b: rgb_1_b {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			label = "D23-D26 blue";
		};
		rgb_2_r: rgb_2_r {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "D3 red";
		};
		rgb_2_g: rgb_2_g {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "D3 green";
		};
		rgb_2_b: rgb_2_b {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "D3 blue";
		};
	};

	/*
	 * The RGB LEDs and the buzzer can alternatively be driven by the PWM
	 * peripherals. The pin assignment intentionally mirrors the gpio-leds
	 * above; only one driver (GPIO or PWM) should be active on a given pin
	 * at a time - this is an application-level decision.
	 */
	pwmleds {
		compatible = "pwm-leds";

		buzzer: buzzer {
			pwms = <&pwm0 0 PWM_KHZ(4) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_1_r: pwm_rgb_1_r {
			pwms = <&pwm1 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_1_g: pwm_rgb_1_g {
			pwms = <&pwm1 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_1_b: pwm_rgb_1_b {
			pwms = <&pwm1 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_2_r: pwm_rgb_2_r {
			pwms = <&pwm2 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_2_g: pwm_rgb_2_g {
			pwms = <&pwm2 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_rgb_2_b: pwm_rgb_2_b {
			pwms = <&pwm2 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button_ack: button_ack {
			gpios = <&gpio0 27 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "acknowledge alarm";
			zephyr,code = <INPUT_KEY_0>;
		};
		button_mute: button_mute {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "mute buzzer";
			zephyr,code = <INPUT_KEY_1>;
		};
		button_onoff: button_onoff {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "on_off device";
			zephyr,code = <INPUT_KEY_2>;
		};
		chrg: chrg {
			gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "LTC4060 CHRG";
			zephyr,code = <INPUT_KEY_3>;
		};
		user_button: button_0 {
			gpios = <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User Button";
			zephyr,code = <INPUT_KEY_4>;
		};
	};

	vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <180000>;
		full-ohms = <(1500000 + 180000)>;
		power-gpios = <&gpio0 31 0>;
	};

	/* Aliases for compatibility with upstream Zephyr samples. */
	aliases {
		sw0 = &user_button;
		led0 = &rgb_1_r;
		led1 = &rgb_1_g;
		led2 = &rgb_1_b;
		led3 = &rgb_2_r;
		pwm-led0 = &pwm_rgb_1_r;
		watchdog0 = &wdt0;
	};
};

&reg {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	gpio-as-nreset;
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	compatible = "nordic,nrf-uart";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm2 {
	status = "okay";
	pinctrl-0 = <&pwm2_default>;
	pinctrl-1 = <&pwm2_sleep>;
	pinctrl-names = "default", "sleep";
};

/* SPI1 -> DW1000 UWB transceiver */
&spi1 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	ieee802154: dw1000@0 {
		compatible = "decawave,dw1000";
		reg = <0>;
		spi-max-frequency = <2000000>;
		int-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;	/* P0.19 */
		reset-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;	/* P0.24 */
		status = "okay";
	};
};

/* SPI2 -> MX25R8035F external SPI-NOR flash */
&spi2 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	mx25r80: mx25r8035f@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		size = <0x800000>;
		jedec-id = [c2 28 14];
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			extdata_partition: partition@0 {
				label = "extdata";
				reg = <0x00000000 0x00002000>;
			};
		};
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0xc000>;
		};
		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 0x32000>;
		};
		slot1_partition: partition@3e000 {
			label = "image-1";
			reg = <0x0003e000 0x32000>;
		};
		scratch_partition: partition@70000 {
			label = "image-scratch";
			reg = <0x00070000 0xa000>;
		};
		storage_partition: partition@7a000 {
			label = "storage";
			reg = <0x0007a000 0x00006000>;
		};
	};
};
